{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "functions": {
    "api/invitation.mjs": {
      "includeFiles": "{dist/*.html,scripts/fonts/**}"
    },
    "api/invitation-image.mjs": {
      "includeFiles": "scripts/fonts/**"
    }
  },
  "routes": [
    {
      "src": "^/$",
      "has": [{ "type": "query", "key": "invite" }],
      "dest": "/api/invitation"
    },
    {
      "src": "^/$",
      "has": [{ "type": "query", "key": "side", "value": "bride" }],
      "dest": "/bride.html"
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    },
    {
      "src": "^/admin/?$",
      "dest": "/index.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
