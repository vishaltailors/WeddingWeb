{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "^/$",
      "has": [{ "type": "query", "key": "side", "value": "bride" }],
      "dest": "/bride.html"
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    },
    {
      "src": "^/admin/?$",
      "dest": "/index.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
