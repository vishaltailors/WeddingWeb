{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "query", "key": "side", "value": "bride" }],
      "destination": "/bride.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
